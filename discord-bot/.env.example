# Discord bot token from the Discord Developer Portal.
CLIENT_TOKEN=replace_with_discord_bot_token

# MongoDB URI for the same database endpoint used by 5thMRsquadJS.
DBLINK=mongodb://username:password@hostname:27017

# Discord server (guild) id where slash commands are registered.
GUILD_ID=replace_with_discord_guild_id

# Steam Web API key used to resolve vanity profile URLs.
STEAM_API=replace_with_steam_web_api_key
